# Supabase — obter em: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Chave service_role (Project Settings → API). NUNCA expor no browser.
# Usada apenas em route handlers do servidor (criar contas, RGPD, retenção).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Segredo para o cron da Vercel poder chamar /api/admin/retention.
# Gera um valor aleatório longo (ex.: openssl rand -hex 32).
CRON_SECRET=
