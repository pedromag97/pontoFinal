# Supabase — obter em: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Chave service_role (Project Settings → API). NUNCA expor no browser.
# Usada apenas em route handlers do servidor (criar contas, RGPD, retenção).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Segredo para os crons poderem chamar /api/admin/retention e
# /api/cron/reminders. Gera um valor aleatório longo (ex.: openssl rand -hex 32).
CRON_SECRET=

# Notificações push (lembretes). Gerar uma vez: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:o-teu-email@exemplo.com
